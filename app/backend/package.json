{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "description": "TekCert REST API (NestJS + TypeORM).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env dist/main.js\"",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "db:migrate": "pnpm typeorm migration:run",
    "db:migration:generate": "pnpm typeorm migration:generate",
    "db:revert": "pnpm typeorm migration:revert",
    "db:deploy": "typeorm migration:run -d dist/database/data-source.js",
    "db:seed:deploy": "node dist/database/seed/index.js",
    "db:seed": "tsx src/database/seed/index.ts",
    "db:reset": "pnpm typeorm schema:drop && pnpm db:migrate && pnpm db:seed",
    "deploy:bundle": "node -e \"require('node:fs').rmSync('../deploy/backend',{recursive:true,force:true})\" && pnpm --filter backend deploy --prod --legacy ../deploy/backend"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@node-rs/argon2": "^2.2.2",
    "@tekcert/types": "workspace:*",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@tekcert/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "files": [
    "dist"
  ]
}
