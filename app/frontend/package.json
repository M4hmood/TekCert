{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "description": "TekCert web app (Next.js App Router).",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:bundle": "node scripts/bundle-standalone.mjs"
  },
  "dependencies": {
    "@tekcert/types": "workspace:*",
    "@tekcert/ui": "workspace:*",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "^6.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tekcert/config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "jsdom": "^27.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
