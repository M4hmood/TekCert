# Base URL of the NestJS API, read at runtime by server components and the /api proxy.
# Locally the API runs on :4000; on AWS this becomes the internal load balancer.
API_URL=http://localhost:4000

# Where certification badge files are served from (optional). Defaults to /badges (frontend/public/badges).
# On AWS this becomes the CloudFront path; add that host to next/image remotePatterns then.
# NEXT_PUBLIC_BADGE_BASE_URL=/badges
