NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgresql://tekcert:tekcert@localhost:5432/tekcert
# Public URL of the web app (email links, allowed Origin)
WEB_URL=http://localhost:3000
# Extra origins allowed to call the API directly from a browser (the frontend proxies /api/*)
CORS_ORIGIN=http://localhost:3000
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
JWT_ACCESS_SECRET=change-me-to-32-or-more-random-characters
# Local dev runs over plain HTTP
COOKIE_SECURE=false
# Mailpit from docker-compose; open http://localhost:8025 to read the emails
SMTP_URL=smtp://localhost:1025
MAIL_FROM=TekCert <no-reply@tek-up.de>
