// TekCert data model. Sprint 0: reference data (catalog, paths, specialties, classes) and a bare User.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  staff
  admin
}

enum CertificationLevel {
  foundational
  associate
  professional
  expert
}

enum PathKind {
  shared
  specialty
}

model Specialty {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  /// oklch hue used for tags, avatars and path accents
  hue       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes        Class[]
  certifications CertificationSpecialty[]
  paths          Path[]

  @@map("specialties")
}

/// A class follows the institute pattern: ING-4-CIM-C (years 4–5) or ING-2-B (years 1–3).
model Class {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  year        Int
  group       String
  specialtyId String?    @db.Uuid
  specialty   Specialty? @relation(fields: [specialtyId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users User[]

  @@index([year])
  @@map("classes")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  /// Stored lowercased; the API normalises before writing
  email     String   @unique
  firstName String
  lastName  String
  role      Role     @default(student)
  classId   String?  @db.Uuid
  class     Class?   @relation(fields: [classId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@map("users")
}

model Provider {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  hue       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certifications Certification[]

  @@map("providers")
}

model Certification {
  id                String             @id @default(uuid()) @db.Uuid
  /// Display code, unique across providers (e.g. SAA-C03, OCA-JAVA)
  code              String             @unique
  slug              String             @unique
  name              String
  /// Vendor exam number when it differs from the display code (e.g. EX-200, 1Z0-808)
  examCode          String?
  level             CertificationLevel
  difficulty        Int
  forAllSpecialties Boolean            @default(false)
  badgeAsset        String?
  isActive          Boolean            @default(true)
  providerId        String             @db.Uuid
  provider          Provider           @relation(fields: [providerId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  specialties CertificationSpecialty[]
  domains     CertificationDomain[]
  chapters    Chapter[]
  pathNodes   PathNode[]               @relation("PathNodeCertification")
  unlocks     PathNode[]               @relation("PathNodePrerequisite")

  @@index([providerId])
  @@index([level])
  @@map("certifications")
}

model CertificationSpecialty {
  certificationId String        @db.Uuid
  specialtyId     String        @db.Uuid
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  specialty       Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([certificationId, specialtyId])
  @@index([specialtyId])
  @@map("certification_specialties")
}

/// An exam domain from the vendor's outline (e.g. "Domain 1 · Secure architectures", 30%).
model CertificationDomain {
  id              String        @id @default(uuid()) @db.Uuid
  certificationId String        @db.Uuid
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  order           Int
  title           String
  shortTitle      String
  weightPct       Int?

  chapters Chapter[]

  @@unique([certificationId, order])
  @@map("certification_domains")
}

model Chapter {
  id               String              @id @default(uuid()) @db.Uuid
  certificationId  String              @db.Uuid
  certification    Certification       @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  domainId         String              @db.Uuid
  domain           CertificationDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  /// Position in the certification's syllabus, 1-based and unique per certification
  order            Int
  title            String
  estimatedMinutes Int

  @@unique([certificationId, order])
  @@index([domainId])
  @@map("chapters")
}

model Path {
  id          String     @id @default(uuid()) @db.Uuid
  /// FOND for the shared Fundamentals path, otherwise the specialty code
  code        String     @unique
  name        String
  kind        PathKind
  specialtyId String?    @unique @db.Uuid
  specialty   Specialty? @relation(fields: [specialtyId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  nodes PathNode[]

  @@map("paths")
}

/// A certification placed on a path graph (column = progression, row = track).
model PathNode {
  id                   String         @id @default(uuid()) @db.Uuid
  pathId               String         @db.Uuid
  path                 Path           @relation(fields: [pathId], references: [id], onDelete: Cascade)
  certificationId      String         @db.Uuid
  certification        Certification  @relation("PathNodeCertification", fields: [certificationId], references: [id])
  col                  Int
  row                  Int
  prerequisiteId       String?        @db.Uuid
  prerequisite         Certification? @relation("PathNodePrerequisite", fields: [prerequisiteId], references: [id])

  @@unique([pathId, certificationId])
  @@unique([pathId, col, row])
  @@map("path_nodes")
}
